{
  "name": "@pbpeterson/typed-fetch",
  "version": "1.1.0",
  "description": "A type-safe HTTP client that returns request errors as values. Inspired by Go's error handling pattern.",
  "keywords": [
    "api",
    "client",
    "error-handling",
    "fetch",
    "go-style",
    "http",
    "json",
    "no-throw",
    "rest",
    "type-safe",
    "typed",
    "typescript"
  ],
  "homepage": "https://github.com/pbpeterson/typed-fetch#readme",
  "bugs": {
    "url": "https://github.com/pbpeterson/typed-fetch/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Peterson Pereira Bozza",
    "email": "petersonbozza7@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbpeterson/typed-fetch.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "errors": [
        "dist/errors/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/index.d.mts",
        "default": "./dist/errors/index.mjs"
      },
      "require": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "audit:prod": "pnpm audit --prod --audit-level low",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "verify-pack": "node scripts/verify-pack.mjs",
    "check-docs": "node scripts/check-docs.mjs",
    "check-consumer": "node scripts/check-consumer.mjs",
    "check-deno-consumer": "node scripts/check-deno-consumer.mjs",
    "smoke:node-min": "node scripts/smoke/node-min.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.74.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "vite": "7.3.6"
    }
  }
}
